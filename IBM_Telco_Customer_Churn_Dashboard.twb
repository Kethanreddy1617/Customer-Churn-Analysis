      <aliases enabled='yes' />
      <column caption='Total Customers' datatype='integer' name='[Calculation_1477233648562176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([customerID])' />
      </column>
      <column caption='Churned Customers' datatype='integer' name='[Calculation_1477233648787457]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(&#13;&#10;    IF [Churn] = &quot;Yes&quot; THEN [customerID] END&#13;&#10;)' />
      </column>
      <column caption='Active Customers' datatype='integer' name='[Calculation_1477233648881666]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(&#13;&#10;    IF [Churn] = &quot;No&quot; THEN [customerID] END&#13;&#10;)' />
      </column>
      <column caption='Churn Rate' datatype='real' name='[Calculation_1477233649016835]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1477233648787457] / [Calculation_1477233648562176]' />
      </column>
      <column caption='Average Monthly Charges' datatype='real' name='[Calculation_1477233649111044]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([MonthlyCharges])' />
      </column>
      <column caption='Customer Tenure Category' datatype='string' name='[Calculation_1477233653313543]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [tenure] &lt;= 12 THEN &quot;0-1 Year&quot;&#13;&#10;ELSEIF [tenure] &lt;= 24 THEN &quot;1-2 Years&quot;&#13;&#10;ELSEIF [tenure] &lt;= 48 THEN &quot;2-4 Years&quot;&#13;&#10;ELSE &quot;4+ Years&quot;&#13;&#10;END' />
      </column>
      <column caption='Charge Category' datatype='string' name='[ChargeCategory]' role='dimension' type='nominal' />
